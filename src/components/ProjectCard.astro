---
/**
 * ProjectCard.astro — Tarjeta de proyecto + su modal de detalle.
 * Recibe un objeto `proyecto` (ver data/projects.js). La media rota las
 * capturas en carrusel (scripts/project-slides.js) y, como el botón
 * "Detalles", abre un <dialog> con la info completa y una galería
 * (scripts/project-modal.js y scripts/project-gallery.js). Ver CLAUDE.md §4 y §5.
 */
const { proyecto, index = 0 } = Astro.props;
const { titulo, descripcion, stack, estado, repo, demo, capturas = [] } =
  proyecto;
const varias = capturas.length > 1;

const enProduccion = estado.toLowerCase().startsWith("produc");
const badgeMod = enProduccion ? "badge--live" : "badge--wip";

const slug = titulo
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "");
const dialogId = `project-${slug}`;
---

<article class="project-card reveal" style={`--reveal-delay: ${index * 90}ms`}>
  <button
    class="project-card__media"
    type="button"
    aria-label={`Ver detalle de ${titulo}`}
    data-project-open={dialogId}
    data-slides={varias ? "" : undefined}
  >
    {
      capturas.length ? (
        capturas.map((captura, i) => (
          <img
            class={`slides__img${i === 0 ? " is-active" : ""}`}
            src={captura.src}
            alt=""
            loading="lazy"
            decoding="async"
            width="1280"
            height="720"
          />
        ))
      ) : (
        <span class="project-card__placeholder" aria-hidden="true">
          &lt;/&gt;
        </span>
      )
    }
    {
      varias && (
        <span class="slides__bars" aria-hidden="true">
          {capturas.map(() => (
            <span class="slides__bar">
              <span class="slides__fill" />
            </span>
          ))}
        </span>
      )
    }
    <span class="project-card__zoom" aria-hidden="true">
      <span class="project-card__zoom-pill">Ver detalle ↗</span>
    </span>
  </button>

  <div class="project-card__body">
    <div class="project-card__top">
      <h3 class="project-card__title">{titulo}</h3>
      <span class={`badge ${badgeMod}`}>{estado}</span>
    </div>

    <p class="project-card__desc">{descripcion}</p>

    <footer class="project-card__footer">
      <ul class="project-card__stack">
        {stack.map((tech) => <li class="chip chip--sm">{tech}</li>)}
      </ul>

      <div class="project-card__links">
        <button
          class="project-card__link"
          type="button"
          data-project-open={dialogId}
        >
          Detalles
        </button>
        {
          repo && (
            <a
              class="project-card__link"
              href={repo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Código <span aria-hidden="true">↗</span>
            </a>
          )
        }
        {
          demo && (
            <a
              class="project-card__link"
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Demo <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </footer>
  </div>
</article>

<dialog
  class="tech-dialog project-dialog"
  id={dialogId}
  aria-labelledby={`${dialogId}-title`}
>
  <div class="tech-dialog__inner project-dialog__inner">
    <button class="tech-dialog__close" type="button" aria-label="Cerrar">
      <span aria-hidden="true">×</span>
    </button>

    <div class="project-dialog__head">
      <h3 class="tech-dialog__title" id={`${dialogId}-title`}>{titulo}</h3>
      <span class={`badge ${badgeMod}`}>{estado}</span>
    </div>

    {
      capturas.length > 0 && (
        <div
          class="gallery"
          data-gallery
          role="region"
          aria-roledescription="carrusel"
          aria-label={`Capturas de ${titulo}`}
        >
          <div class="gallery__stage">
            {capturas.map((captura, i) => (
              <img
                class={`gallery__img${i === 0 ? " is-active" : ""}`}
                src={captura.src}
                alt={`${titulo}: ${captura.alt}`}
                loading="lazy"
                decoding="async"
                width="1280"
                height="720"
                aria-hidden={i === 0 ? undefined : "true"}
              />
            ))}
            {varias && (
              <>
                <button
                  class="gallery__nav gallery__nav--prev"
                  type="button"
                  aria-label="Captura anterior"
                  data-gallery-prev
                >
                  <span aria-hidden="true">‹</span>
                </button>
                <button
                  class="gallery__nav gallery__nav--next"
                  type="button"
                  aria-label="Captura siguiente"
                  data-gallery-next
                >
                  <span aria-hidden="true">›</span>
                </button>
                <span class="gallery__count" aria-live="polite">
                  1 / {capturas.length}
                </span>
              </>
            )}
          </div>
          <p class="gallery__caption">{capturas[0].alt}</p>
          {varias && (
            <div class="gallery__thumbs">
              {capturas.map((captura, i) => (
                <button
                  class={`gallery__thumb${i === 0 ? " is-active" : ""}`}
                  type="button"
                  aria-label={`Ver captura ${i + 1}: ${captura.alt}`}
                  aria-current={i === 0 ? "true" : undefined}
                  data-gallery-go={i}
                  data-caption={captura.alt}
                >
                  <img
                    src={captura.src}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="1280"
                    height="720"
                  />
                </button>
              ))}
            </div>
          )}
        </div>
      )
    }

    <p class="project-dialog__desc">{descripcion}</p>

    <ul class="project-dialog__stack">
      {stack.map((tech) => <li class="chip chip--sm">{tech}</li>)}
    </ul>

    {
      (repo || demo) && (
        <div class="project-dialog__links">
          {repo && (
            <a
              class="btn btn--ghost"
              href={repo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver código ↗
            </a>
          )}
          {demo && (
            <a
              class="btn btn--primary"
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver demo ↗
            </a>
          )}
        </div>
      )
    }
  </div>
</dialog>
